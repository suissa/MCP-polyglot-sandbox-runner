{
  "name": "@allascode/sandbox-runner",
  "version": "1.0.0",
  "description": "Standardized MCP Sandbox Runner with Docker and gVisor isolation",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "node mcp/server.mjs",
    "start:network": "node mcp/server.mjs --network",
    "start:sdk": "tsx src/index.ts",
    "test": "node --test test/*.test.ts test/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "sandbox",
    "gvisor",
    "docker",
    "security",
    "runner"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
